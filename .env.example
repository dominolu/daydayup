# Copy to .env for Docker Compose. Local go run reads exported environment variables.
GATEWAY_API_KEY=replace-with-a-long-random-client-key
GATEWAY_ADMIN_KEY=replace-with-a-different-long-random-admin-key
SENSENOVA_ACCOUNT_1_KEY=sk-replace-account-1
SENSENOVA_ACCOUNT_2_KEY=sk-replace-account-2

# WorkBuddy / CodeBuddy OAuth accounts (provider "workbuddy").
# uid 是 X-User-Id，access/refresh 来自账号 OAuth 导入或桌面端 token 存储。
# WORKBUDDY_INTL_1_ACCESS=wb-access-token
# WORKBUDDY_INTL_1_REFRESH=wb-refresh-token
# WORKBUDDY_INTL_1_UID=wb-uid

# TokenPlan（书生·端砚）accounts (provider "tokenplan").
# 控制台 → API Key # 6 个月、单人最多 10 把。
# TOKENPLAN_ACCOUNT_1_KEY=tp-...

# Optional: 32-byte standard-base64 session key; otherwise data/sessions.key is generated.
# GATEWAY_SESSION_STORE_KEY=...
